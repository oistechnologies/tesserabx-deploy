# =============================================================================
# TesseraBX production .env template (deploy repo).
#
# This is a TRIMMED template covering the variables you must set for a
# production deploy. The full, annotated list of every supported variable
# lives in the upstream repo's .env.example. Base your real .env on that
# file, then make sure at least the values below are set.
#
# HOW THIS REACHES PRODUCTION (do NOT commit a real .env):
#   - Recommended: paste your complete .env into a GitHub Actions secret named
#     TESSERABX_DOTENV. The deploy workflow writes it onto the host at deploy
#     time. Secrets never touch this repo or the host's git tree.
#   - Alternative: keep a host-persisted .env (chmod 600) and point the
#     deploy script's ENV_FILE at it.
# =============================================================================

# --- Reverse proxy network (must already exist on the host) ------------------
PROXY_NETWORK=web

# --- Public URL the app is reached at (used in outbound email links) ---------
APP_BASE_URL=https://support.example.com

# --- PostgreSQL --------------------------------------------------------------
DB_HOST=db
DB_PORT=5432
DB_NAME=tesserabx
DB_USER=tesserabx
DB_PASSWORD=CHANGE_ME_strong_password
DB_SCHEMA=public
DB_SSL=false

# --- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# --- Secrets (long random strings; never reuse the dev defaults) -------------
JWT_SECRET=CHANGE_ME_long_random_string
NOTIFICATIONS_UNSUBSCRIBE_SECRET=CHANGE_ME_long_random_string

# --- Outbound email ----------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com
MAIL_FROM_DOMAIN=example.com
OUTBOUND_EMAIL_ENABLED=true

# --- File storage (use s3 or b2 in production for offsite backups) -----------
CBFS_DEFAULT_PROVIDER=b2
# Populate the CBFS_PROVIDER_* values from the upstream .env.example when
# CBFS_DEFAULT_PROVIDER is s3 or b2.

# --- Backups -----------------------------------------------------------------
BACKUP_RETENTION_DAYS=14

# --- AI (optional; leave disabled if not configured) -------------------------
AI_ENABLED=false
# AI_PROVIDER=openrouter
# AI_API_KEY=
# AI_MODEL=
